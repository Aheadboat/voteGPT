      "checkConstraints": {
        "election_evidence_one_subject": {
          "name": "election_evidence_one_subject",
          "value": "num_nonnulls(\"election_evidence\".\"election_id\", \"election_evidence\".\"stage_id\", \"election_evidence\".\"contest_id\", \"election_evidence\".\"candidacy_id\", \"election_evidence\".\"ballot_line_id\") = 1"
        },
        "election_evidence_subject_binding": {
          "name": "election_evidence_subject_binding",
          "value": "coalesce(\n    jsonb_typeof(\"election_evidence\".\"assertion\") = 'object' and \"election_evidence\".\"assertion\"->>'id' = \"election_evidence\".\"id\" and \"election_evidence\".\"assertion\"->>'kind' = \"election_evidence\".\"kind\"\n    and \"election_evidence\".\"assertion\"->'subject'->>'id' = coalesce(\"election_evidence\".\"election_id\", \"election_evidence\".\"stage_id\", \"election_evidence\".\"contest_id\", \"election_evidence\".\"candidacy_id\", \"election_evidence\".\"ballot_line_id\")\n    and \"election_evidence\".\"assertion\"->'subject'->>'kind' = case when \"election_evidence\".\"election_id\" is not null then 'election' when \"election_evidence\".\"stage_id\" is not null then 'stage'\n      when \"election_evidence\".\"contest_id\" is not null then 'contest' when \"election_evidence\".\"candidacy_id\" is not null then 'candidacy' else 'ballot_line' end, false)"
        },
        "election_evidence_required_provenance": {
          "name": "election_evidence_required_provenance",
          "value": "coalesce(\n    \"election_evidence\".\"assertion\" ?& array['document_id','mapping_id','locator','original_term','retrieved_at','verified_at','effective','current_until']\n    and jsonb_typeof(\"election_evidence\".\"assertion\"->'locator') = 'string' and length(\"election_evidence\".\"assertion\"->>'locator') between 1 and 500, false)"
        }
      },
      "isRLSEnabled": false
    },
